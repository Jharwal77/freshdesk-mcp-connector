# ---------------------------------------------------------------------------
# Freshdesk MCP connector - example configuration.
# Copy to `.env` and fill in. `.env` is gitignored - never commit real keys.
# ---------------------------------------------------------------------------

# Your Freshdesk subdomain, i.e. the "acme" in https://acme.freshdesk.com
FRESHDESK_DOMAIN=acme

# API key from Freshdesk > Profile Settings > API Key (or Your Profile > View API Key).
# Auth is HTTP Basic: the API key is the username, the literal string "X" is the password.
FRESHDESK_API_KEY=replace-me

# Freshdesk subdomain for API calls. Override only to point at a local mock
# (e.g. http://127.0.0.1:8099). Leave blank to derive from FRESHDESK_DOMAIN.
# FRESHDESK_BASE_URL=http://127.0.0.1:8099

# Rate-limit profile: auto | trial | growth | pro | enterprise
# "auto" starts conservative and ratchets up using the X-RateLimit-Total header
# Freshdesk returns on every response. Recommended.
FRESHDESK_PLAN=auto

# Hard ceiling on outbound HTTP attempts per tool call (including retries).
FRESHDESK_MAX_RETRIES=3

# Per-request network timeout in seconds.
FRESHDESK_TIMEOUT=15

# Total wall-clock budget for a single tool call, in seconds. When exceeded the
# connector returns partial results plus an explicit `degraded` warning rather
# than hanging the agent.
FRESHDESK_REQUEST_DEADLINE=25

# Read-only by default. Set to true to register the single write tool
# (freshdesk_add_private_note). The demo keeps this false.
FRESHDESK_ENABLE_WRITES=false

# Optional JSONL audit trail of every outbound call (method, path, status,
# latency, rate-limit headers). No secrets and no ticket bodies are written.
# FRESHDESK_AUDIT_LOG=./audit/freshdesk-calls.jsonl
